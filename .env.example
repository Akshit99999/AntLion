# ─────────────────────────────────────────────────────────────────
# Antlion — environment variable configuration template
# Copy this file to .env and fill in real values.
# .env is in .gitignore — never commit secrets.
# ─────────────────────────────────────────────────────────────────

# ── Alert Dispatch ────────────────────────────────────────────────
# Discord webhook URL (create one under Server Settings → Integrations)
ANTLION_DISCORD_WEBHOOK=

# Slack incoming webhook URL
ANTLION_SLACK_WEBHOOK=

# Additional generic/SIEM webhook targets, comma-separated.
# Each entry receives a JSON alert on every dispatch.
ANTLION_WEBHOOK_URLS=

# Minimum severity level to dispatch an alert  (LOW | MEDIUM | HIGH | CRITICAL)
# Invalid values fall back to HIGH. Default: HIGH
ANTLION_ALERT_SEVERITY=HIGH

# ── Alert Suppression ─────────────────────────────────────────────
# A public honeypot under credential-stuffing load emits thousands of
# near-identical alerts and drowns the SIEM. Antlion collapses repeats from
# the same IP performing the same attack class within this window, then
# sends one summary alert carrying the occurrence count.
# Set window to 0 to disable suppression. Default: 300
ANTLION_ALERT_DEDUP_WINDOW_SEC=300

# Master switch for alert suppression. Default: true
ANTLION_ALERT_DEDUP_ENABLED=true

# ── Storage ───────────────────────────────────────────────────────
# Absolute path to the SQLite database file
# Defaults to ~/.antlion/antlion.db if not set
ANTLION_DB_PATH=

# Base directory for pcaps, models, and the database.
# Default: ~/.antlion
ANTLION_HOME=

# ── Query API Security ────────────────────────────────────────────
# Shared secret required by every /api/v1 data route.
# Send it as either header:
#     X-API-Key: <key>
#     Authorization: Bearer <key>
# When unset, data routes are UNPROTECTED and a warning is logged at startup.
# These routes expose captured credentials — set this before exposing the API.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ANTLION_API_KEY=

# Comma-separated CORS allowlist. Never use "*": a wildcard combined with
# credentials lets any website read threat intelligence from a SOC operator.
# Default: http://localhost:8000,http://127.0.0.1:8000
ANTLION_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Trust X-Forwarded-For for source IP attribution.
# Leave false unless the decoy genuinely sits behind a reverse proxy, since
# otherwise any client can spoof its IP and poison attacker attribution.
ANTLION_TRUST_PROXY=false

# ── Decoy ports ───────────────────────────────────────────────────
ANTLION_SSH_PORT=2222
ANTLION_WEB_PORT=8080
ANTLION_TELNET_PORT=2323
ANTLION_API_PORT=8000
